{
  "schemaVersion": 1,
  "id": "for-meteor-addon",
  "version": "${version}",
  "name": "for-meteor-addon",
  "description": "Meteor Client addon with a packet SpeedMine module (packet mine + rebreak).",
  "authors": [
    "piolunson"
  ],
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "piolunson.addon.SpeedMineAddon"
    ]
  },
  "custom": {
    "meteor-client:color": "140,142,255",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=21",
    "minecraft": ["${mc_version}"],
    "meteor-client": "*"
  }
}
